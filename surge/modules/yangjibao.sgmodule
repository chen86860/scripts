#!url=https://raw.githubusercontent.com/chen86860/scripts/main/surge/modules/yangjibao.sgmodule
#!name=yangjibao
#!desc=养基宝去广告，并将账户升级为 VIP

[URL Rewrite]

^https?:\/\/app-api\.yangjibao\.com\/unify_ad - reject
^https?:\/\/app-api\.yangjibao\.com\/content\/v1\/ad\/config - reject

[Script]

yangjibao_account = type=http-response, pattern=^https?:\/\/app-api\.yangjibao\.com\/users\/v1\/account(\?.*)?$, requires-body=true, max-size=-1, timeout=10, script-path=https://raw.githubusercontent.com/chen86860/scripts/main/surge/scripts/yangjibao.js

[MITM]

hostname = %APPEND% app-api.yangjibao.com
